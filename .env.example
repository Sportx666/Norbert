# Copy to .env and fill in. Never commit .env or paste its contents into a chat.

# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Leave empty on first run; send /start to your bot and it replies with this number.
TELEGRAM_CHAT_ID=

# Supabase > Connect > Session pooler (works over IPv4). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: template location (default: config/week_template.yaml)
# FT_TEMPLATE=config/week_template.yaml

# Phase 2
# ANTHROPIC_API_KEY=
